EntropicRogersShephard.SharpEntropicRogersShephard : Prop
EntropicRogersShephard.crossDifferenceDensity_uniformSimplex (m : ℕ) [NeZero m] {a b : ℝ} (ha : 0 < a) (hb : 0 < b)
  (z : Fin m → ℝ) :
  EntropicRogersShephard.crossDifferenceDensity
      (EntropicRogersShephard.uniformDensity (EntropicRogersShephard.simplex m a))
      (EntropicRogersShephard.uniformDensity (EntropicRogersShephard.simplex m b)) z =
    EntropicRogersShephard.overlapRadius a b z ^ m /
      (a ^ m * b ^ m * (MeasureTheory.volume (EntropicRogersShephard.simplex m 1)).toReal)
EntropicRogersShephard.layer_coefficients_forced_by_normalization (m : ℕ) (c : ℕ → ℝ)
  (h :
    ∀ (s : ℝ),
      0 ≤ s →
        ∑ j ∈ Finset.range (m + 1), c j * ↑m * EntropicRogersShephard.integerBeta (m - 1) (m - j) * s ^ j = (1 + s) ^ m)
  {j : ℕ} (hj : j ≤ m) : c j * ↑m * EntropicRogersShephard.integerBeta (m - 1) (m - j) = ↑(m.choose j)
